{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terrace Preset Registry",
  "type": "object",
  "required": ["version", "presets"],
  "properties": {
    "version": {
      "type": "string"
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    }
  }
}
