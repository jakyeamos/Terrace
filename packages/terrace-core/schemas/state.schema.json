{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terrace Strict Core State",
  "type": "object",
  "required": [
    "schema_version",
    "state_revision",
    "project",
    "workflow",
    "roadmap",
    "active_slice",
    "red_gate",
    "green_gate",
    "protected_tests",
    "decisions",
    "sessions",
    "migration",
    "handoff",
    "handoffs",
    "workstreams",
    "design_sources",
    "preflights",
    "ai_reviews",
    "debt",
    "documentation",
    "test_evaluations",
    "rule_audits",
    "waivers",
    "backfills",
    "report_card",
    "backlog",
    "blocked_actions",
    "quick_tasks"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "state_revision": { "type": "integer", "minimum": 0 },
    "project": {
      "type": "object",
      "required": ["name", "created_at"],
      "properties": {
        "name": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["status", "mode", "active_feature"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "initialized",
            "intake_recorded",
            "interrogated",
            "spec_compiled",
            "roadmap_ready",
            "slice_planned",
            "red_required",
            "implementation_allowed",
            "green_required",
            "protected",
            "handoff_ready"
          ]
        },
        "mode": {
          "type": "string",
          "enum": ["strict", "standard", "low_effort", "recovery"]
        },
        "active_feature": { "type": ["string", "null"] }
      }
    },
    "roadmap": {
      "type": "object",
      "required": ["phases"],
      "properties": {
        "phases": { "type": "array" }
      }
    },
    "active_slice": { "type": ["object", "null"] },
    "red_gate": { "type": "object" },
    "green_gate": { "type": "object" },
    "protected_tests": { "type": "array" },
    "decisions": { "type": "array" },
    "sessions": { "type": "array" },
    "migration": { "type": ["object", "null"] },
    "handoff": { "type": ["object", "null"] },
    "handoffs": { "type": "array" },
    "workstreams": { "type": "object" },
    "design_sources": { "type": "object" },
    "preflights": { "type": "object" },
    "ai_reviews": { "type": "array" },
    "debt": { "type": "array" },
    "documentation": { "type": "object" },
    "test_evaluations": { "type": "array" },
    "rule_audits": { "type": "array" },
    "waivers": { "type": "array" },
    "backfills": { "type": "array" },
    "report_card": { "type": "object" },
    "backlog": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array" }
      },
      "additionalProperties": true
    },
    "blocked_actions": { "type": "array" },
    "quick_tasks": { "type": "array" }
  },
  "additionalProperties": true
}
