{
  "name": "@jakyeamos33/terrace",
  "version": "0.2.0",
  "description": "Spec-driven, test-governed AI development framework",
  "type": "commonjs",
  "packageManager": "pnpm@11.7.0",
  "author": {
    "name": "Jakye Amos"
  },
  "homepage": "https://github.com/jakyeamos/Terrace#readme",
  "bugs": {
    "url": "https://github.com/jakyeamos/Terrace/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "codex",
    "governance",
    "workflow"
  ],
  "main": "src/terrace-tools.cjs",
  "bin": {
    "terrace": "src/terrace-tools.cjs"
  },
  "exports": {
    ".": "./packages/terrace-core/src/index.cjs"
  },
  "files": [
    "src/",
    "scripts/",
    "packages/terrace-core/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.cjs",
    "build": "pnpm run typecheck",
    "test": "node scripts/vitest-run.cjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "package": "pnpm run package:dry-run",
    "package:dry-run": "node scripts/package-dry-run.cjs",
    "release:dry-run": "pnpm publish --dry-run --access public --no-git-checks --config.node-linker=hoisted",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "node scripts/dependency-security.mjs",
    "corpus:evaluate": "node scripts/terrace-corpus-eval.cjs",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run test:coverage && pnpm run package:dry-run"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "yaml": "^2.8.3"
  },
  "bundledDependencies": [
    "fast-glob",
    "ignore",
    "yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakyeamos/terrace.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "4.1.2",
    "@vitest/coverage-v8": "4.1.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
