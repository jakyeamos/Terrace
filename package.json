{
  "name": "terrace",
  "version": "0.1.0",
  "description": "Spec-driven, test-governed AI development framework",
  "type": "commonjs",
  "main": "src/terrace-tools.cjs",
  "bin": {
    "terrace": "src/terrace-tools.cjs"
  },
  "exports": {
    ".": "./packages/terrace-core/src/index.cjs"
  },
  "files": [
    "src/",
    "packages/terrace-core/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.cjs",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "package:dry-run": "npm pack --dry-run --cache /tmp/terrace-npm-cache",
    "ci": "npm run typecheck && npm run lint && npm test && npm run test:coverage && npm run package:dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakyeamos/terrace.git"
  },
  "license": "MIT",
  "devDependencies": {
    "vitest": "4.1.2",
    "@vitest/coverage-v8": "4.1.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
