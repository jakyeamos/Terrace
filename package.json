{
  "name": "@jakyeamos33/terrace",
  "version": "0.2.0",
  "description": "Spec-driven, test-governed AI development framework",
  "type": "commonjs",
  "packageManager": "pnpm@11.7.0",
  "author": {
    "name": "Jakye Amos"
  },
  "homepage": "https://github.com/jakyeamos/Terrace#readme",
  "bugs": {
    "url": "https://github.com/jakyeamos/Terrace/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "codex",
    "governance",
    "workflow"
  ],
  "main": "src/terrace-tools.cjs",
  "bin": {
    "terrace": "src/terrace-tools.cjs"
  },
  "exports": {
    ".": "./packages/terrace-core/src/index.cjs"
  },
  "files": [
    "src/",
    "scripts/",
    "packages/terrace-core/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.cjs",
    "build": "pnpm run typecheck",
    "test": "node scripts/vitest-run.cjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "package": "pnpm run package:dry-run",
    "package:dry-run": "node scripts/package-dry-run.cjs",
    "release:dry-run": "pnpm publish --dry-run --access public --no-git-checks --config.node-linker=hoisted",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "node scripts/dependency-security.mjs",
    "corpus:evaluate": "node scripts/terrace-corpus-eval.cjs",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run test:coverage && pnpm run package:dry-run"
  },
  "dependencies": {
    "@nodelib/fs.scandir": "^2.1.5",
    "@nodelib/fs.stat": "^2.0.5",
    "@nodelib/fs.walk": "^1.2.8",
    "braces": "^3.0.3",
    "fast-glob": "^3.3.3",
    "fastq": "^1.20.1",
    "fill-range": "^7.1.1",
    "glob-parent": "^5.1.2",
    "ignore": "^7.0.5",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "is-number": "^7.0.0",
    "merge2": "^1.4.1",
    "micromatch": "^4.0.8",
    "picomatch": "^2.3.2",
    "queue-microtask": "^1.2.3",
    "reusify": "^1.1.0",
    "run-parallel": "^1.2.0",
    "to-regex-range": "^5.0.1",
    "yaml": "^2.8.3"
  },
  "bundledDependencies": [
    "@nodelib/fs.stat",
    "@nodelib/fs.scandir",
    "@nodelib/fs.walk",
    "braces",
    "fast-glob",
    "fastq",
    "fill-range",
    "glob-parent",
    "ignore",
    "is-extglob",
    "is-glob",
    "is-number",
    "merge2",
    "micromatch",
    "picomatch",
    "queue-microtask",
    "reusify",
    "run-parallel",
    "to-regex-range",
    "yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakyeamos/terrace.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.0.0",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
